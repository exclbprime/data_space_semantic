{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tide/schemas/recipe.schema.json",
  "title": "recipe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipe_id",
    "project_id",
    "p1_version",
    "p2_version",
    "schema_version",
    "feature_fields",
    "target_field",
    "missing_strategy",
    "smoothing_window",
    "lag",
    "train_fraction"
  ],
  "properties": {
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "p1_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "p2_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "feature_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "control_input",
          "flow_rate",
          "temperature"
        ]
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "target_field": {
      "type": "string",
      "const": "target_temp"
    },
    "missing_strategy": {
      "type": "string",
      "enum": [
        "forward_fill",
        "train_mean"
      ]
    },
    "smoothing_window": {
      "type": "integer",
      "enum": [
        1,
        3,
        5
      ]
    },
    "lag": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "train_fraction": {
      "type": "number",
      "const": 0.7
    }
  }
}
