{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tide/schemas/grant.schema.json",
  "title": "grant.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "request_id",
    "subject_user_id",
    "subject_team_id",
    "participant_id",
    "project_id",
    "resource_ids",
    "actions",
    "purpose",
    "authorizer_user_id",
    "valid_from",
    "valid_until",
    "status",
    "version"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_user_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_team_id": {
      "type": "string",
      "minLength": 1
    },
    "participant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "READ_DATA",
          "SUBMIT_RECIPE",
          "READ_RESULT"
        ]
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "authorizer_user_id": {
      "type": "string",
      "minLength": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
